{
  "name": "notideus",
  "version": "1.0.1",
  "description": "Official Node.js SDK for the Notideus email API",
  "keywords": [
    "notideus",
    "email",
    "email api",
    "transactional email",
    "marketing email",
    "sdk",
    "api client",
    "nodejs",
    "typescript",
    "whatsapp"
  ],
  "license": "MIT",
  "repository": "github:notideus/sdk-node",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@types/node": "^26.6.4",
    "eslint": "^10.12.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.10.0",
    "vitest": "^5.0.3"
  }
}
